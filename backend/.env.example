# ============================================================================
# ZappyFood backend - environment variables
# Copy this file to .env and fill in the values.
# ============================================================================

# ---- Supabase / PostgreSQL connection string (REQUIRED) --------------------
# Get it from the Supabase Dashboard -> Connect button.
# Prefer the "Session pooler" (port 5432). Replace [YOUR-PASSWORD] with the
# database password you set when creating the project.
#
# Session pooler example:
#   postgresql://postgres.<project-ref>:<PASSWORD>@aws-0-<region>.pooler.supabase.com:5432/postgres
# Direct connection example (IPv6):
#   postgresql://postgres:<PASSWORD>@db.<project-ref>.supabase.co:5432/postgres
#
# For a LOCAL postgres (docker-compose) use:
#   postgresql://postgres:postgres@localhost:5432/zappyfood
DATABASE_URL=postgresql://postgres.your-ref:your-password@aws-0-region.pooler.supabase.com:5432/postgres

# Force SSL on/off. Leave unset to auto-enable for *.supabase.com hosts.
# Set to "false" for a local postgres.
# DB_SSL=true

# Max size of the connection pool.
DB_POOL_MAX=10

# ---- Auth (REQUIRED) -------------------------------------------------------
# Any long random string. Generate with: openssl rand -hex 32
JWT_SECRET=change-me-to-a-long-random-secret
ACCESS_MINUTES=60
REFRESH_DAYS=30

# ---- Object storage (OPTIONAL - image uploads) ----------------------------
# The image upload feature currently uses Emergent's managed object storage.
# It is optional: the app runs fine without it (uploads will simply fail).
# For a fully self-hosted deployment, swap this for S3 / Supabase Storage.
# EMERGENT_LLM_KEY=
# INTEGRATION_PROXY_URL=https://integrations.emergentagent.com
